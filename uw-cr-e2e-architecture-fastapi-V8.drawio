                </mxCell>
                <mxCell id="t4c21" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3C88;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" value="Pipeline YAMLs - model tier - max_turns 24-80 - effort - grounding - salvage - FE_RUNNER=bedrock (ECS) | cli (laptop)" vertex="1">
                    <mxGeometry height="64" width="582" x="682" y="396" as="geometry"/>
                </mxCell>
                <mxCell id="t4-gstages" parent="1" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#EDF2FB;strokeColor=#334966;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;3-Stage Global Pipeline&lt;/b&gt; (ECS · cloud · human approves each):  &lt;b&gt;① PRD&lt;/b&gt; → &lt;b&gt;② FRD&lt;/b&gt; → &lt;b&gt;[arch_sync_gate]&lt;/b&gt; → &lt;b&gt;③ EPIC-SET&lt;/b&gt;  ·  Architecture Workspace (Laptop · one per programme): &lt;b&gt;ADR → NFR → SDD → SRD&lt;/b&gt; (ADLC-tech-architect)  ·  SRD approval closes Arch Workspace → Global resumes automatically  ·  EPIC-SET approval opens one Mini Workspace per EPIC" vertex="1">
                    <mxGeometry height="40" width="1190" x="80" y="473" as="geometry"/>
                </mxCell>
                <mxCell id="t4c22" parent="1" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#E8EEF9;strokeColor=#1F3C88;strokeWidth=1.2;verticalAlign=top;" value="" vertex="1">
                    <mxGeometry height="240" width="580" x="80" y="514" as="geometry"/>
                </mxCell>
                <mxCell id="t4c23" parent="1" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#1F3C88;align=left;verticalAlign=middle;spacingLeft=4;" value="LANGGRAPH MACRO  -  pipeline flow" vertex="1">
                    <mxGeometry height="20" width="564" x="88" y="518" as="geometry"/>
                </mxCell>
                <mxCell id="t4c24" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3C88;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;" value="&lt;b&gt;StateGraph&lt;/b&gt;&lt;br/&gt;One pipeline thread per workspace&lt;br/&gt;run-node (Claude executes) + gate-node (human approves/rejects) per stage&lt;br/&gt;&lt;b style=&quot;color:#B45309&quot;&gt;arch_sync_gate:&lt;/b&gt; new interrupt node — parks Global until Architecture Workspace closes" vertex="1">
                    <mxGeometry height="88" width="270" x="96" y="546" as="geometry"/>
                </mxCell>
                <mxCell id="t4c25" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3C88;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;" value="&lt;b&gt;Human Approval Gate&lt;/b&gt;&lt;br/&gt;Pauses after every stage for human review&lt;br/&gt;Approve → advance · Reject → re-run (max 3x)" vertex="1">
                    <mxGeometry height="88" width="270" x="376" y="546" as="geometry"/>
                </mxCell>
                <mxCell id="t4c26" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3C88;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;" value="&lt;b&gt;Workspace hand-offs&lt;/b&gt;&lt;br/&gt;arch_sync_gate: FRD approved → Architecture Workspace opens on laptop (singleton)&lt;br/&gt;fan_out: EPIC-SET approval → one Mini per EPIC · M1+M2 on ECS · M3+ on laptop&lt;br/&gt;merge: closes when all Minis done" vertex="1">
                    <mxGeometry height="88" width="270" x="96" y="648" as="geometry"/>
                </mxCell>
                <mxCell id="t4c27" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B32626;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;" value="&lt;b&gt;Checkpointing&lt;/b&gt;&lt;br/&gt;ECS: RDS PostgreSQL — pipeline survives container restarts&lt;br/&gt;Laptop: in-memory (MemorySaver) — no DB needed" vertex="1">
                    <mxGeometry height="88" width="270" x="376" y="648" as="geometry"/>
                </mxCell>
                <mxCell id="t4c28" parent="1" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#FDF0E1;strokeColor=#E06C1E;strokeWidth=1.2;verticalAlign=top;" value="" vertex="1">
                    <mxGeometry height="260" width="580" x="700" y="514" as="geometry"/>
                </mxCell>
                <mxCell id="t4c29" parent="1" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#E06C1E;align=left;verticalAlign=middle;spacingLeft=4;" value="LANGGRAPH MICRO  —&amp;nbsp; Claude reasons turn-by-turn inside each document stage&amp;nbsp;&lt;div&gt;&amp;nbsp;(FE_RUNNER=bedrock)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="20" width="474" x="708" y="518" as="geometry"/>
                </mxCell>
                <mxCell id="t4c30" parent="1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E06C1E;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" value="&amp;nbsp;ECS" vertex="1">
                    <mxGeometry height="18" width="80" x="1188" y="519" as="geometry"/>
                </mxCell>
                <mxCell id="t4c31" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E06C1E;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;" value="&lt;b&gt;BedrockReActRunner — Claude&#39;s turn-by-turn loop (ECS)&lt;/b&gt;&lt;br/&gt;① MICRO gives Claude the task + upstream docs as context&lt;br/&gt;② Claude reasons → picks a @tool → calls it → observes result → repeats (up to 12 turns)&lt;br/&gt;③ end_turn signal → result to MACRO gate → human approval opens&lt;br/&gt;&lt;b&gt;5 Python @tools:&lt;/b&gt; kb_search · kb_search_multi · read_file · write_file · get_upstream_artifact&lt;br/&gt;ECS IAM task role — no API key, no CLI, no browser login needed" vertex="1">
                    <mxGeometry height="130" width="548" x="716" y="546" as="geometry"/>
                </mxCell>
                <mxCell id="t4-prompt-src" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FDF6EC;strokeColor=#E06C1E;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;" value="&lt;b&gt;📋 What Claude receives on ECS  (system prompt = None — all in user turn)&lt;/b&gt;&lt;br/&gt;① Skill name as plain text  e.g. /ADLC-business-analyst:ba-brd — NOT executed, no plugin loader on ECS&lt;br/&gt;② Deliverable — deliverable: field in uw-cr-global.yaml  (only always-present instruction)&lt;br/&gt;③ &lt;b style=&quot;color:#b71c1c&quot;&gt;agent-config/&amp;lt;stage&amp;gt;.md&lt;/b&gt; — project-specific instructions injected verbatim (⭐ substitute for SKILL.md)&lt;br/&gt;④ KB context — RAG chunks from Postgres pulled at build time (static, before MICRO starts)&lt;br/&gt;⑤ Output contract — filenames + format rules (auto-generated)&lt;br/&gt;&lt;b style=&quot;color:#1F3C88&quot;&gt;Optimize:&lt;/b&gt; Create agent-config/prd.md · frd.md · adr.md …  Fix workspace_id in RunRequest → unblocks kb_search tools" vertex="1">
                    <mxGeometry height="148" width="548" x="716" y="680" as="geometry"/>
                </mxCell>
                <mxCell id="t4c33" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1E7A3C;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;" value="&lt;b&gt;L1 KB Build — one-time laptop setup&lt;/b&gt;&lt;br/&gt;Claude Code CLI + ADLC-kb reads RED scan → builds typed Knowledge Base&lt;br/&gt;kb-check gate validates completeness before publish" vertex="1">
                    <mxGeometry height="88" width="548" x="716" y="840" as="geometry"/>
                </mxCell>
                <mxCell id="t4c34" parent="1" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#E8F5ED;strokeColor=#1E7A3C;strokeWidth=1.2;verticalAlign=top;" value="" vertex="1">
                    <mxGeometry height="150" width="1200" x="80" y="798" as="geometry"/>
                </mxCell>
