                <mxCell id="t4c20" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3C88;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" value="FastAPI control plane - routers - JobService - approvals FR-P3 - personas FR-P1 - /recover" vertex="1">
