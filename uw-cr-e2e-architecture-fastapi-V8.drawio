                </mxCell>
                <mxCell id="t4c39" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B32626;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Chunk RAG&lt;/b&gt;&lt;br/&gt;pgvector HNSW + BM25 RRF - stage outputs auto-indexed" vertex="1">
                    <mxGeometry height="104" width="276" x="972" y="828" as="geometry"/>
                </mxCell>
                <mxCell id="t4c40" parent="1" style="text;html=1;fontSize=10.5;fontColor=#334966;align=left;verticalAlign=middle;" value="Harness: turn caps observed - prompt cache (cachePoint on ECS, automatic on laptop) - token / cache / cost metering - budgets - salvage / recover." vertex="1">
                    <mxGeometry height="36" width="1180" x="96" y="956" as="geometry"/>
                </mxCell>
                <mxCell id="t4c41" parent="1" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#FDF6EC;strokeColor=#E06C1E;strokeWidth=2;verticalAlign=top;" value="" vertex="1">
                    <mxGeometry height="720" width="620" x="1340" y="322" as="geometry"/>
                </mxCell>
                <mxCell id="t4-arch-bg" parent="1" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;verticalAlign=top;" value="" vertex="1">
                    <mxGeometry height="200" width="580" x="1340" y="870" as="geometry"/>
                </mxCell>
                <mxCell id="t4-arch-hdr" parent="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#B45309;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=left;spacingLeft=12;verticalAlign=middle;" value="ARCHITECTURE WORKSPACE  —  Singleton per programme  —  Developer Laptop" vertex="1">
                    <mxGeometry height="30" width="546" x="1352" y="880" as="geometry"/>
                </mxCell>
                <mxCell id="t4-arch-detail" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;" value="&lt;b&gt;What it does:&lt;/b&gt; Runs the 4 technical architecture stages on the developer&#39;s laptop.&lt;br/&gt;&lt;b&gt;Pipeline:&lt;/b&gt; ADR → NFR → SDD → SRD  (sequential, one per approval)&lt;br/&gt;&lt;b&gt;Plugin:&lt;/b&gt; ADLC-tech-architect — architect persona, skills, methodology loaded by Claude Code CLI&lt;br/&gt;&lt;b&gt;Trigger:&lt;/b&gt; Created automatically when Global reaches arch_sync_gate (after FRD approved)&lt;br/&gt;&lt;b&gt;Close:&lt;/b&gt; SRD approved → workspace closes → worker resumes Global pipeline&lt;br/&gt;&lt;b&gt;ID:&lt;/b&gt; {app}--architecture  (deterministic singleton — cannot open twice)&lt;br/&gt;&lt;b&gt;Readable by:&lt;/b&gt; Global (reads SRD for EPIC-SET) · Mini (reads SDD/NFR/ADR for LLD)" vertex="1">
                    <mxGeometry height="158" width="546" x="1352" y="916" as="geometry"/>
                </mxCell>
                <mxCell id="t4c42" parent="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E06C1E;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=left;spacingLeft=12;verticalAlign=middle;" value="MINI WORKSPACE  -  per EPIC  -  ECS (M1-M2) then Laptop (M3-M12)&amp;nbsp;" vertex="1">
                    <mxGeometry height="30" width="486" x="1352" y="332" as="geometry"/>
                </mxCell>
                <mxCell id="t4c43" parent="1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E06C1E;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" value="LAPTOP" vertex="1">
                    <mxGeometry height="22" width="92" x="1854" y="336" as="geometry"/>
                </mxCell>
                <mxCell id="t4c44" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E06C1E;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;" value="&lt;b&gt;How Mini Workspace runs (per EPIC)&lt;/b&gt;&lt;br/&gt;• M1 Feature Spec + M2 User Stories: LangGraph MICRO on ECS (Bedrock IAM role)&lt;br/&gt;• M3 LLD onwards: developer laptop — ADLC-* plugins load, full Claude Code ecosystem&lt;br/&gt;• ADLC plugins give Claude its role, methodology, and skills&lt;br/&gt;• Reads SRD + SDD + NFR + ADR from Architecture Workspace via readable_workspace_ids" vertex="1">
                    <mxGeometry height="108" width="580" x="1360" y="370" as="geometry"/>
                </mxCell>
                <mxCell id="t4c45" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E06C1E;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;" value="&lt;b&gt;L3 Code Stage — What Claude does when you run /fe-develop&lt;/b&gt;&lt;br&gt;① Receives full context: Feature Spec + SRD + User Stories&amp;nbsp;&lt;br&gt;② Creates git branch, writes real application code into the repository&lt;br&gt;③ Tests run — if failing, Claude reads error and self-corrects (up to 60 turns)&lt;br&gt;④ All tests green → developer triggers PR Sync to advance the pipeline" vertex="1">
                    <mxGeometry height="130" width="580" x="1360" y="500" as="geometry"/>
                </mxCell>
                <mxCell id="t4c46" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E06C1E;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;" value="&lt;b&gt;PR Sync — Laptop work feeds back to server&lt;/b&gt;&lt;br/&gt;POST /ws/{id}/dev/pr → records branch commit as the deliverable&lt;br/&gt;LangGraph MACRO wakes from interrupt() → advances to M8 Security + M12 UAT" vertex="1">
                    <mxGeometry height="76" width="580" x="1360" y="652" as="geometry"/>
                </mxCell>
                <mxCell id="t4c47" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3C88;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=5;" value="&lt;b&gt;LangGraph MemorySaver — Pipeline state on laptop (dev mode)&lt;/b&gt;&lt;br/&gt;Pipeline state is held in memory — no database needed for local development. If you restart, re-running resumes from the last approved stage. On ECS: same LangGraph MACRO graph, state saved to RDS (AsyncPostgresSaver)." vertex="1">
                    <mxGeometry height="58" width="580" x="1360" y="744" as="geometry"/>
                </mxCell>
                <mxCell id="t4c48" parent="1" style="text;html=1;fontSize=10.5;fontColor=#E06C1E;align=left;verticalAlign=middle;" value="Layer 3 stays laptop-only: real repositories, real tests -- accuracy proven by execution, not prose." vertex="1">
                    <mxGeometry height="40" width="580" x="1360" y="822" as="geometry"/>
                </mxCell>
                <mxCell id="t4-miniflow" parent="1" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#FDF6EC;strokeColor=#E06C1E;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=9.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" value="&lt;b&gt;Mini Workspace — Step-by-step flow per EPIC&lt;/b&gt;&lt;br/&gt;① Global approves EPIC-SET → one Mini Workspace per EPIC opens&lt;br/&gt;② M1 Feature Spec · M2 User Stories: LangGraph MICRO on ECS (Bedrock ReAct · reads SRD from Architecture WS)&lt;br/&gt;③ M3 LLD onwards: developer runs /fe-develop → Claude codes on laptop with ADLC plugins&lt;br/&gt;④ PR Sync → server wakes → M8 Security + M12 UAT docs run server-side (ECS)&lt;br/&gt;⑤ All 12 stages approved → Mini closes · All EPICs closed → Global pipeline completes" vertex="1">
                    <mxGeometry height="148" width="580" x="1360" y="866" as="geometry"/>
                </mxCell>
                <mxCell id="t4c49" parent="1" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#FCEAEA;strokeColor=#B32626;strokeWidth=2;verticalAlign=top;" value="" vertex="1">
                    <mxGeometry height="230" width="1900" x="60" y="1092" as="geometry"/>
                </mxCell>
                <mxCell id="t4c50" parent="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#B32626;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=left;spacingLeft=12;verticalAlign=middle;" value="DATA PLANE  -  AWS" vertex="1">
                    <mxGeometry height="30" width="260" x="72" y="1102" as="geometry"/>
                </mxCell>
                <mxCell id="t4c51" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E05243;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;shape=mxgraph.aws3.s3;" value="Amazon S3" vertex="1">
