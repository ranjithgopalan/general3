                <mxCell id="t4c52" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B32626;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Amazon S3&lt;/b&gt;&lt;br/&gt;artefact bodies (SSE-KMS, presigned GET) - corpus uploads - local dir in dev" vertex="1">
                    <mxGeometry height="106" width="300" x="440" y="1142" as="geometry"/>
                </mxCell>
                <mxCell id="t4c53" parent="1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#B32626;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" value="S3" vertex="1">
