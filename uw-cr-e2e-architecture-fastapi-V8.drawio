                </mxCell>
                <mxCell id="t4c37" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1E7A3C;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;kb-check gate&lt;/b&gt;&lt;br/&gt;ids - edges - evidence - export; fail-closed" vertex="1">
                    <mxGeometry height="104" width="276" x="388" y="828" as="geometry"/>
                </mxCell>
                <mxCell id="t4c38" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1E7A3C;strokeWidth=1.2;fontColor=#1A1A1A;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Grounding check&lt;/b&gt;&lt;br/&gt;[ID] citations vs KB + upstream - warn | required" vertex="1">
